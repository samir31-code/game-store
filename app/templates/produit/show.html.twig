{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} — GameStore{% endblock %}

{% block body %}
{# Fil d'Ariane en haut de page #}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('produit_index') }}">Catalogue</a>
        </li>
        {% if produit.categorie %}
            <li class="breadcrumb-item">
                <a href="{{ path('produit_index', {categorie: produit.categorie.id}) }}">
                    {{ produit.categorie.nom }}
                </a>
            </li>
        {% endif %}
        <li class="breadcrumb-item active" aria-current="page">{{ produit.nom }}</li>
    </ol>
</nav>

<div class="row">
    {# ════════════════════════════════════════════════════════════ #}
    {# ── Colonne Gauche : Carrousel d'images ──────────────────── #}
    {# ════════════════════════════════════════════════════════════ #}
    <div class="col-md-5 mb-4">
        {# Récupération des images nettoyées #}
        {% set images = [] %}
        {% if produit.image %}
            {% for img in produit.image|split(',') %}
                {% if img|trim is not empty %}
                    {% set images = images|merge([img|trim]) %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if images|length > 0 %}
            <div id="productCarousel" class="carousel slide border rounded shadow-sm p-3 bg-white" data-bs-ride="carousel">

                {# Indicateurs (petits traits sous le carrousel) #}
                {% if images|length > 1 %}
                    <div class="carousel-indicators">
                        {% for img in images %}
                            <button type="button"
                                    data-bs-target="#productCarousel"
                                    data-bs-slide-to="{{ loop.index0 }}"
                                    class="{{ loop.first ? 'active' : '' }}"
                                    aria-current="{{ loop.first ? 'true' : 'false' }}"
                                    aria-label="Slide {{ loop.index }}"></button>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Liste des images #}
                <div class="carousel-inner">
                    {% for img in images %}
                        <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                            <img src="{{ asset('images/produits/' ~ img) }}"
                                 class="d-block w-100"
                                 alt="{{ produit.nom }}"
                                 style="height: 380px; object-fit: contain;">
                        </div>
                    {% endfor %}
                </div>

                {# Flèches de navigation (affichées uniquement si > 1 image) #}
                {% if images|length > 1 %}
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                        <span class="visually-hidden">Précédent</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                        <span class="visually-hidden">Suivant</span>
                    </button>
                {% endif %}

            </div>
        {% else %}
            {# Image par défaut si le champ image est vide #}
            <div class="border rounded shadow-sm p-3 bg-white text-center">
                <img src="{{ asset('images/logo.png') }}"
                     class="img-fluid"
                     alt="{{ produit.nom }}"
                     style="height: 380px; object-fit: contain;">
            </div>
        {% endif %}
    </div>

    {# ════════════════════════════════════════════════════════════ #}
    {# ── Colonne Droite : Informations du produit ─────────────── #}
    {# ════════════════════════════════════════════════════════════ #}
    <div class="col-md-7">
        <h1 class="mb-2">{{ produit.nom }}</h1>

        <p class="text-muted">
            {% if produit.categorie %}
                📁 {{ produit.categorie.nom }}
            {% endif %}
            {% if produit.marque %}
                — 🏭 {{ produit.marque }}
            {% endif %}
        </p>

        {# Étiquettes / Badges #}
        <div class="mb-3">
            {% for etiquette in produit.etiquettes %}
                <span class="badge bg-info me-1">{{ etiquette.nom }}</span>
            {% endfor %}
        </div>

        <hr>

        {# Description #}
        {% if produit.description %}
            <div class="mb-4">
                <h5>📝 Description</h5>
                <p>{{ produit.description|nl2br }}</p>
            </div>
        {% endif %}

        {# Caractéristiques #}
        <div class="mb-4">
            <h5>📦 Caractéristiques</h5>
            <table class="table table-bordered">
                {% if produit.marque %}
                <tr>
                    <th style="width: 35%;">Marque</th>
                    <td>{{ produit.marque }}</td>
                </tr>
                {% endif %}
                {% if produit.dimensionL %}
                <tr>
                    <th>Dimensions (L x H x P)</th>
                    <td>
                        {{ produit.dimensionL }} x
                        {{ produit.dimensionH }} x
                        {{ produit.dimensionP }} cm
                    </td>
                </tr>
                {% endif %}
                {% if produit.poids %}
                <tr>
                    <th>Poids</th>
                    <td>{{ produit.poids }} kg</td>
                </tr>
                {% endif %}
                <tr>
                    <th>Référence</th>
                    <td>{{ produit.referenceProduit }}</td>
                </tr>
            </table>
        </div>

        {# Prix #}
        <div class="mb-4">
            <h5>💰 Prix</h5>
            <table class="table table-bordered">
                <tr>
                    <th style="width: 35%;">Prix HT</th>
                    <td>{{ produit.prixHt }} €</td>
                </tr>
                <tr>
                    <th>TVA</th>
                    <td>{{ produit.tvaProduit }} %</td>
                </tr>
                <tr class="table-primary">
                    <th>Prix TTC</th>
                    <td class="fw-bold fs-5">{{ produit.prixTtc }} €</td>
                </tr>
            </table>
        </div>

        {# Stock #}
        <div class="mb-4">
            {% if produit.etatStock == 'disponible' %}
                <span class="badge bg-success fs-6">
                    ✅ En stock ({{ produit.quantiteStock }} disponibles)
                </span>
            {% elseif produit.etatStock == 'sur_commande' %}
                <span class="badge bg-warning text-dark fs-6">
                    📦 Sur commande
                </span>
            {% else %}
                <span class="badge bg-danger fs-6">
                    ❌ Rupture de stock
                </span>
            {% endif %}
        </div>

        {# Boutons d'action #}
        <div class="d-flex gap-2 mt-4">
            {% if is_granted('ROLE_CLIENT') and produit.etatStock == 'disponible' %}
                <a href="{{ path('panier_ajouter', {id: produit.id}) }}"
                   class="btn btn-primary btn-lg">
                    🛒 Ajouter au panier
                </a>
            {% elseif not is_granted('ROLE_USER') %}
                <a href="{{ path('app_login') }}"
                   class="btn btn-outline-primary btn-lg">
                    🔐 Connectez-vous pour commander
                </a>
            {% endif %}
            <a href="{{ path('produit_index') }}"
               class="btn btn-outline-secondary btn-lg">
                ← Retour au catalogue
            </a>
        </div>

    </div>
</div>
{% endblock %}
