{% extends 'base.html.twig' %}
{% block title %}Modifier l'adresse{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="mb-4">✏️ Modifier l'adresse</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type) }}
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        {{ form_label(form.numero) }}
                        {{ form_widget(form.numero) }}
                    </div>
                    <div class="col-md-9 mb-3">
                        {{ form_label(form.voie) }}
                        {{ form_widget(form.voie) }}
                        {{ form_errors(form.voie) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.complementAdresse1) }}
                    {{ form_widget(form.complementAdresse1) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.complementAdresse2) }}
                    {{ form_widget(form.complementAdresse2) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.complementAdresse3) }}
                    {{ form_widget(form.complementAdresse3) }}
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.codePostal) }}
                        {{ form_widget(form.codePostal) }}
                        {{ form_errors(form.codePostal) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.ville) }}
                        {{ form_widget(form.ville) }}
                        {{ form_errors(form.ville) }}
                    </div>
                </div>
                {# codepays caché - toujours FR #}
                {{ form_widget(form.codePays) }}
                <div class="mb-3">
                    {{ form_label(form.detailLivraison) }}
                    {{ form_widget(form.detailLivraison) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        💾 Modifier
                    </button>
                    <a href="{{ path('compte_adresse_index') }}"
                       class="btn btn-secondary">
                        Annuler
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
