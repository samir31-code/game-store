{% extends 'base.html.twig' %}
{% block title %}{{ message.sujet }}{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">📧 {{ message.sujet }}</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm mb-3">
                    <tr>
                        <th>De</th>
                        <td>
                            {{ message.expediteur.prenom }}
                            {{ message.expediteur.nom }}
                        </td>
                    </tr>
                    <tr>
                        <th>Date</th>
                        <td>{{ message.dateEnvoi|date('d/m/Y H:i') }}</td>
                    </tr>
                </table>
                <hr>
                <div class="p-3 bg-light rounded">
                    {{ message.contenu|nl2br }}
                </div>
            </div>
        </div>
        <a href="{{ path('compte_messages') }}" class="btn btn-secondary mt-3">
            ← Retour aux messages
        </a>
    </div>
</div>
{% endblock %}
