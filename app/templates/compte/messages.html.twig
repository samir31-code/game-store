{% extends 'base.html.twig' %}
{% block title %}Mes messages{% endblock %}
{% block body %}
<h1 class="mb-4">📧 Mes messages</h1>

{% if messages is empty %}
    <div class="alert alert-info">Vous n'avez pas encore de message.</div>
{% else %}
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Expéditeur</th>
                <th>Sujet</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for message in messages %}
            <tr class="{{ not message.lu ? 'fw-bold' : '' }}">
                <td>{{ message.expediteur.prenom }} {{ message.expediteur.nom }}</td>
                <td>{{ message.sujet }}</td>
                <td>{{ message.dateEnvoi|date('d/m/Y H:i') }}</td>
                <td>
                    {% if message.lu %}
                        <span class="badge bg-secondary">Lu</span>
                    {% else %}
                        <span class="badge bg-primary">Nouveau</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('compte_message_lire', {id: message.id}) }}"
                       class="btn btn-primary btn-sm">
                        👁️ Lire
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<a href="{{ path('compte_index') }}" class="btn btn-secondary">← Retour</a>
{% endblock %}
