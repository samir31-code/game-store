{% extends 'base.html.twig' %}
{% block title %}Modifier {{ etiquette.nom }}{% endblock %}
{% block body %}
<h1 class="mb-4">✏️ Modifier — {{ etiquette.nom }}</h1>
{{ form_start(form) }}
<div class="mb-3">
    {{ form_label(form.nom) }}
    {{ form_widget(form.nom) }}
    {{ form_errors(form.nom) }}
</div>
<div class="mb-3">
    {{ form_label(form.description) }}
    {{ form_widget(form.description) }}
</div>
<div class="d-flex gap-2">
    <button type="submit" class="btn btn-warning">💾 Modifier</button>
    <a href="{{ path('webmaster_etiquette_index') }}" class="btn btn-secondary">Annuler</a>
</div>
{{ form_end(form) }}
{% endblock %}
