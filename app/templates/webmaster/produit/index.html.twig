{% extends 'base.html.twig' %}
{% block title %}Produits — Webmaster{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🎮 Produits</h1>
    <span class="text-muted small">
        ⚠️ Vous pouvez modifier les produits mais pas en créer ni en supprimer.
    </span>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Référence</th>
            <th>Nom</th>
            <th>Catégorie</th>
            <th>Prix TTC</th>
            <th>Stock</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        {% for produit in produits %}
        <tr>
            <td>{{ produit.referenceProduit }}</td>
            <td>{{ produit.nom }}</td>
            <td>{{ produit.categorie ? produit.categorie.nom : '-' }}</td>
            <td>{{ produit.prixTtc }} €</td>
            <td>
                {% if produit.etatStock == 'disponible' %}
                    <span class="badge bg-success">{{ produit.quantiteStock }}</span>
                {% else %}
                    <span class="badge bg-danger">Rupture</span>
                {% endif %}
            </td>
            <td>
                <a href="{{ path('webmaster_produit_edit', {id: produit.id}) }}"
                   class="btn btn-warning btn-sm">
                    ✏️ Modifier
                </a>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<a href="{{ path('webmaster_index') }}" class="btn btn-secondary">
    ← Retour
</a>
{% endblock %}
