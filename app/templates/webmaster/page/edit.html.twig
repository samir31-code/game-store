{% extends 'base.html.twig' %}
{% block title %}Modifier {{ page.titre }}{% endblock %}
{% block body %}
<h1 class="mb-4">✏️ Modifier — {{ page.titre }}</h1>
{{ form_start(form) }}
<div class="mb-3">
    {{ form_label(form.titre) }}
    {{ form_widget(form.titre) }}
    {{ form_errors(form.titre) }}
</div>
<div class="mb-3">
    {{ form_label(form.slug) }}
    {{ form_widget(form.slug) }}
    {{ form_errors(form.slug) }}
</div>
<div class="mb-3">
    {{ form_label(form.contenu) }}
    {{ form_widget(form.contenu) }}
</div>
<div class="mb-3 form-check">
    {{ form_widget(form.estPubliee) }}
    {{ form_label(form.estPubliee) }}
</div>
<div class="d-flex gap-2">
    <button type="submit" class="btn btn-warning">💾 Modifier</button>
    <a href="{{ path('webmaster_page_index') }}" class="btn btn-secondary">Annuler</a>
</div>
{{ form_end(form) }}
{% endblock %}
