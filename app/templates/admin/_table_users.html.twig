<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">{{ titre }}</h5>

    {# Bouton Ajouter — uniquement pour les rôles non client #}
    {% if show_add is defined and show_add %}
        <a href="{{ path('admin_user_new', {role: role}) }}"
           class="btn btn-success btn-sm">
            ➕ Ajouter un {{ label }}
        </a>
    {% endif %}
</div>

{% if users is empty %}
    <div class="alert alert-info">
        Aucun utilisateur dans cette catégorie.
    </div>
{% else %}
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.nom }}</td>
                <td>{{ user.prenom }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role == 'ROLE_ADMIN' %}
                            <span class="badge bg-danger">🛡️ Admin</span>
                        {% elseif role == 'ROLE_ADMIN_PRODUIT' %}
                            <span class="badge bg-warning text-dark">⚙️ Admin Produit</span>
                        {% elseif role == 'ROLE_GESTIONNAIRE_COMMANDE' %}
                            <span class="badge bg-info">📦 Gestionnaire</span>
                        {% elseif role == 'ROLE_WEBMASTER' %}
                            <span class="badge bg-info">🌐 Webmaster</span>
                        {% elseif role == 'ROLE_CLIENT' %}
                            <span class="badge bg-primary">🛒 Client</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>
                    {% if user != app.user %}
                        <a href="{{ path('webmaster_user_edit', {id: user.id}) }}"
                           class="btn btn-warning btn-sm">
                            ✏️ Modifier
                        </a>
                        <form method="post"
                              action="{{ path('webmaster_user_delete', {id: user.id}) }}"
                              style="display:inline"
                              onsubmit="return confirm('Supprimer cet utilisateur ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-danger btn-sm">
                                🗑️ Supprimer
                            </button>
                        </form>
                    {% else %}
                        <span class="text-muted small">Votre compte</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
