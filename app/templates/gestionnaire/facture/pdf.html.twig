<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>Facture
			{{ facture.numeroFacture }}</title>
		<style>
			body {
				font-family: 'Arial', sans-serif;
				color: #333;
				font-size: 13px;
				line-height: 1.4;
				padding: 10px;
			}
			/* Structure Entête (Logo à gauche, Infos facture à droite) */
			.header-table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 40px;
			}
			.header-table td {
				vertical-align: middle;
			}
			.logo {
				font-size: 24px;
				font-weight: bold;
				color: #007bff;
			}
			.logo img {
				vertical-align: middle;
				margin-right: 8px;
				height: 32px;
			}
			.invoice-info {
				text-align: right;
				font-size: 13px;
			}

			/* Blocs intermédiaires (Boutique / Client) */
			.details-table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 40px;
			}
			.details-table td {
				width: 50%;
				vertical-align: top;
			}
			.block-title {
				font-weight: bold;
				font-size: 14px;
				margin-bottom: 5px;
			}

			/* Table des Articles */
			.items-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 20px;
			}
			.items-table th {
				background-color: #212529;
				color: white;
				padding: 10px;
				text-align: left;
				font-weight: bold;
				font-size: 13px;
			}
			.items-table td {
				padding: 12px 10px;
				border-bottom: 1px solid #dee2e6;
			}
			.text-right {
				text-align: right;
			}
			.text-center {
				text-align: center;
			}

			/* Bloc des Totaux à droite */
			.totals-container {
				width: 100%;
				margin-top: 20px;
			}
			.totals-table {
				width: 35%;
				margin-left: 65%;
				border-collapse: collapse;
			}
			.totals-table td {
				padding: 6px 10px;
			}
			.total-ttc-label,
			.total-ttc-value {
				color: #007bff;
				font-weight: bold;
				font-size: 16px;
			}

			/* Pied de page */
			.footer {
				text-align: center;
				margin-top: 80px;
				font-size: 12px;
				color: #6c757d;
			}
		</style>
	</head>
	<body>

		<table class="header-table">
			<tr>
				<td class="logo">
					{% if logo %}
						<img src="{{ logo }}" alt="Logo">
					{% else %}
						<span style="color:#007bff; font-weight:bold; font-size:24px;">?
						</span>
					{% endif %}
					GameStore
				</td>
				<td class="invoice-info">
					<strong>Facture N° :</strong>
					{{ facture.numeroFacture }}<br>
					<strong>Commande liée :</strong>
					{{ commande.numeroCommande }}<br>
					<strong>Date de facturation :</strong>
					{{ facture.dateFacturation|date('d/m/Y') }}
				</td>
			</tr>
		</table>

		<table class="details-table">
			<tr>
				<td>
					<div class="block-title">Boutique :</div>
					GameStore Toulouse<br>
					Place du Capitole<br>
					31000 Toulouse
				</td>
				<td>
                <div class="block-title">Client :</div>
                <strong>{{ commande.user.prenom }} {{ commande.user.nom|upper }}</strong><br>

                {% if commande.adresseLivraison %}
                    {# 1. En priorité, l'adresse directement liée à la commande #}
                    {{ commande.adresseLivraison.numero }} {{ commande.adresseLivraison.voie }}<br>
                    {{ commande.adresseLivraison.codePostal }} {{ commande.adresseLivraison.ville|upper }}

                {% elseif commande.user.adresses is defined and commande.user.adresses|length > 0 %}
                    {# 2. Si vide, on regarde si le User a une collection d'adresses (au pluriel) #}
                    {% set adresseProfil = commande.user.adresses|first %}
                    {{ adresseProfil.numero }} {{ adresseProfil.voie }}<br>
                    {{ adresseProfil.codePostal }} {{ adresseProfil.ville|upper }}

                {% else %}
                    {# 3. Sécurité finale si aucune adresse n'est disponible nulle part #}
                    Adresse non renseignée
                {% endif %}
            </td>
			</tr>
		</table>

		<table class="items-table">
			<thead>
				<tr>
					<th>Article</th>
					<th class="text-right">Prix U. HT</th>
					<th class="text-center">Quantité</th>
					<th class="text-right">Total TTC</th>
				</tr>
			</thead>
			<tbody>
				{# S'il y a une boucle dynamique sur vos lignes de commande, insérez-la ici #}
				{# Exemple courant : {% for ligne in commande.commandeDetails %} #}
					<tr><td>Spider-Man 2
					</td><td class="text-right"> {{ commande.coutTotalHt|number_format(2, ',', ' ') }}
						€</td>
					<td class="text-center">1</td>
					<td class="text-right">{{ commande.coutTotalTtc|number_format(2, ',', ' ') }}
						€</td>
				</tr>
				{# {% endfor %} #}
			</tbody>
		</table>

		<div class="totals-container">
			<table class="totals-table">
				<tr>
					<td style="font-weight: bold; padding-bottom: 10px;">Total HT :</td>
					<td class="text-right" style="font-weight: bold; padding-bottom: 10px;">
						{{ commande.coutTotalHt|number_format(2, ',', ' ') }}
						€
					</td>
				</tr>
				<tr style="border-top: 1px solid #333;">
					<td class="total-ttc-label" style="padding-top: 10px;">Total TTC :</td>
					<td class="text-right total-ttc-value" style="padding-top: 10px;">
						{{ commande.coutTotalTtc|number_format(2, ',', ' ') }}
						€
					</td>
				</tr>
			</table>
		</div>

		<div class="footer">
			<p>Merci pour votre achat sur GameStore !</p>
			<p>Mode de règlement appliqué :
				<strong>STRIPE</strong>
			</p>
		</div>

	</body>
</html>
