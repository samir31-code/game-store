{% extends 'base.html.twig' %}

{% block title %}Gestionnaire — GameStore{% endblock %}

{% block body %}
<h1 class="mb-4">📦 Espace Gestionnaire</h1>

{# ── Compteurs cliquables ── #}
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <a href="{{ path('gestionnaire_commande_index', {filtre: 'attente'}) }}"
           class="text-decoration-none">
            <div class="card text-white bg-warning shadow h-100"
                 style="cursor:pointer; min-height:120px">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h2>{{ commandes_attente|length }}</h2>
                    <p class="mb-0 fs-5">⏳ Commandes en attente de paiement</p>
                    <small class="opacity-75">Cliquez pour voir</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="{{ path('gestionnaire_commande_index', {filtre: 'validees'}) }}"
           class="text-decoration-none">
            <div class="card text-white bg-success shadow h-100"
                 style="cursor:pointer; min-height:120px">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h2>{{ commandes_validees|length }}</h2>
                    <p class="mb-0 fs-5">✅ Commandes payées à expédier</p>
                    <small class="opacity-75">Cliquez pour voir</small>
                </div>
            </div>
        </a>
    </div>
</div>

{# ── Actions ── #}
<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center d-flex flex-column justify-content-between">
                <div>
                    <h4>📋 Toutes les commandes</h4>
                    <p class="text-muted">
                        Voir toutes les commandes, valider les paiements,
                        générer les factures
                    </p>
                </div>
                <a href="{{ path('gestionnaire_commande_index') }}"
                   class="btn btn-primary mt-2">
                    Gérer toutes les commandes
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center d-flex flex-column justify-content-between">
                <div>
                    <h4>🏷️ Étiquettes</h4>
                    <p class="text-muted">
                        Gérer les étiquettes des produits
                    </p>
                </div>
                <a href="{{ path('gestionnaire_etiquette_index') }}"
                   class="btn btn-info mt-2">
                    Gérer les étiquettes
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center d-flex flex-column justify-content-between">
                <div>
                    <h4>📦 Stock</h4>
                    <p class="text-muted">
                        Contrôler et mettre à jour le stock des produits
                    </p>
                </div>
                <a href="{{ path('gestionnaire_stock_index') }}"
                   class="btn btn-warning mt-2">
                    Gérer le stock
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
