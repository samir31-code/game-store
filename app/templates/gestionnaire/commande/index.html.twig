{% extends 'base.html.twig' %}

{% block title %}{{ titre }} — GameStore{% endblock %}

{% block body %}

{# ── En-tête avec titre dynamique ── #}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ titre }}</h1>
    <span class="badge bg-primary fs-6">
        {{ commandes|length }} commande(s)
    </span>
</div>

{# ── Filtres rapides ── #}
<div class="d-flex gap-2 mb-4">
    <a href="{{ path('gestionnaire_commande_index') }}"
       class="btn btn-sm {{ filtre is null ? 'btn-dark' : 'btn-outline-dark' }}">
        📋 Toutes
    </a>
    <a href="{{ path('gestionnaire_commande_index', {filtre: 'attente'}) }}"
       class="btn btn-sm {{ filtre == 'attente' ? 'btn-warning' : 'btn-outline-warning' }}">
        ⏳ En attente
    </a>
    <a href="{{ path('gestionnaire_commande_index', {filtre: 'validees'}) }}"
       class="btn btn-sm {{ filtre == 'validees' ? 'btn-success' : 'btn-outline-success' }}">
        ✅ Payées
    </a>
</div>

{# ── Tableau des commandes ── #}
{% if commandes is empty %}
    <div class="alert alert-info">
        Aucune commande pour ce filtre.
    </div>
{% else %}
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Numéro</th>
                <th>Client</th>
                <th>Date</th>
                <th>Total TTC</th>
                <th>Statut paiement</th>
                <th>Mode paiement</th>
                <th>Expédition</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
            <tr class="{{ not commande.paiementValide ? 'table-warning' : 'table-success' }}">

                {# Numéro #}
                <td><strong>{{ commande.numeroCommande }}</strong></td>

                {# Client #}
                <td>
                    <a href="{{ path('gestionnaire_client_show', {id: commande.user.id}) }}" class="fw-bold text-decoration-none text-dark link-primary">
                        👤 {{ commande.user.prenom }} {{ commande.user.nom|upper }}
                    </a>

                    {% if commande.user.typeCompte == 'professionnel' %}
                        <span class="badge bg-info text-dark ms-1 small" style="font-size: 0.7rem;">🏢 PRO</span>
                    {% else %}
                        <span class="badge bg-secondary ms-1 small" style="font-size: 0.7rem;">👤 PERSO</span>
                    {% endif %}
                    <br>
                    <small class="text-muted">{{ commande.user.email }}</small>
                </td>

                {# Date #}
                <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>

                {# Total TTC #}
                <td class="fw-bold text-primary">{{ commande.coutTotalTtc }} €</td>

                {# Statut paiement #}
                <td>
                    {% if commande.paiementValide %}
                        <span class="badge bg-success">✅ Payé</span>
                    {% else %}
                        <span class="badge bg-warning text-dark">⏳ En attente</span>
                    {% endif %}
                </td>

                {# Mode paiement #}
                <td>
                    {% if commande.typePaiement == 'carte' %}
                        💳 Carte
                    {% elseif commande.typePaiement == 'virement' %}
                        🏦 Virement
                    {% elseif commande.typePaiement == 'paypal' %}
                        🅿️ PayPal
                    {% else %}
                        {{ commande.typePaiement }}
                    {% endif %}
                </td>

                {# Expédition #}
                <td>
                    {% if commande.paiementValide %}
                        {% if commande.statutExpedition == 'en_preparation' %}
                            <span class="badge bg-warning text-dark">📦 En préparation</span>
                        {% elseif commande.statutExpedition == 'expedie' %}
                            <span class="badge bg-primary">🚚 Expédiée</span>
                        {% elseif commande.statutExpedition == 'livre' %}
                            <span class="badge bg-success">✅ Livrée</span>
                        {% else %}
                            <span class="badge bg-secondary">⏳ À expédier</span>
                        {% endif %}
                    {% else %}
                        <span class="badge bg-secondary">—</span>
                    {% endif %}
                </td>

                {# Action #}
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('gestionnaire_commande_show', {id: commande.id}) }}"
                           class="btn btn-primary btn-sm">
                            👁️ Détail
                        </a>

                        {# Bouton de suppression visible uniquement si non payée #}
                        {% if not commande.paiementValide %}
                            <form method="post" action="{{ path('gestionnaire_commande_delete', {'id': commande.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cette commande ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_commande' ~ commande.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    🗑️ Supprimer
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </td>

            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<a href="{{ path('gestionnaire_index') }}" class="btn btn-secondary mt-2">
    ← Retour
</a>
{% endblock %}
